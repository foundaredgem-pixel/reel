# Instagram publishing
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_API_VERSION=v26.0

# Optional protection for the web app.
APP_KEY=

# Your public Render URL, without a trailing slash.
PUBLIC_BASE_URL=

# Optional base64-encoded Netscape cookies.txt for your own Instagram session.
INSTAGRAM_COOKIES_B64=

# Limits
MAX_DOWNLOAD_MB=200
MAX_DURATION_SECONDS=900
IG_POLL_SECONDS=10
IG_MAX_POLLS=36
SHARE_TO_FEED=true
